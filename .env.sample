# Copy this file to .env and fill in your local values.
# .env is gitignored and will not be committed.

# --- Local development ---
# DATABASE_URL=postgresql://postgres@127.0.0.1/postgres
# PORT=5001

# --- Production (Oracle Cloud + Neon) ---
NODE_ENV=production
PORT=5001
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
FRONTEND_URL=http://YOUR_PUBLIC_IP:3000

# Frontend build (client/.env.production):
# VITE_API_URL=http://YOUR_PUBLIC_IP:5001
