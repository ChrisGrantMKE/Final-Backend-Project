# Copy this file to .env and fill in your local values.
# .env is gitignored and will not be committed.

# Neon (cloud) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/dev_db?sslmode=require"

# Local Postgres example (requires Postgres running on your machine):
DATABASE_URL=postgresql://postgres@127.0.0.1/postgres

PORT=5001

# Frontend app URL for CORS (optional in local dev; set in production)
# FRONTEND_URL=http://localhost:5173
